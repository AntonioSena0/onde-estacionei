# Copie para .env e preencha. O .env nunca vai para o Git.
# Variáveis EXPO_PUBLIC_ entram no código do app: nunca coloque segredos nelas.

# App: estilo do mapa (MapLibre). OpenFreeMap é gratuito, sem chave e sem cadastro.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# App: servidor OSRM para a rota a pé até o carro (público, sem chave).
EXPO_PUBLIC_ROUTING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot

# App: busca de endereço pelo CEP (ViaCEP, gratuito, sem chave).
EXPO_PUBLIC_POSTAL_CODE_URL=https://viacep.com.br/ws

# App: endereço <-> coordenada (Nominatim/OpenStreetMap, gratuito, sem chave, até 1 consulta por segundo).
EXPO_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org

# App: endereço da API de sincronização. Precisa ser HTTPS; em desenvolvimento aceita
# http://10.0.2.2:3333 (emulador Android) ou http://localhost:3333. Vazio = só offline.
EXPO_PUBLIC_API_URL=

# Servidor: endereço e porta. Use 127.0.0.1 atrás de um proxy HTTPS.
HOST=127.0.0.1
PORT=3333

# Servidor: arquivo do banco SQLite.
DATABASE_FILE=server/data/onde-estacionei.db

# Servidor: certificado e chave TLS para servir HTTPS direto (opcional se houver proxy HTTPS).
TLS_CERT_FILE=
TLS_KEY_FILE=

# Servidor: origens web autorizadas, separadas por vírgula. Vazio = nenhuma página web.
ALLOWED_ORIGINS=

# Servidor: requisições por minuto por IP e por aparelho.
RATE_LIMIT_PER_MINUTE=120
